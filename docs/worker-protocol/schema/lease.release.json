{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Worker to API. The worker dropped the session.",
  "properties": {
    "lease_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Lease Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "lease.release",
      "default": "lease.release",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "session_id",
    "type"
  ],
  "title": "lease.release message",
  "type": "object"
}
