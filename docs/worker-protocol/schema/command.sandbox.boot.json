  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "API to worker. `command_id` travels on the wire as `id`.",
  "properties": {
    "id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Lease Id",
      "type": "string"
    },
    "op": {
      "const": "sandbox.boot",
      "type": "string"
    },
    "payload": {
      "properties": {
        "context": {
          "properties": {
            "agent": {
              "$ref": "#/$defs/ContextAgent"
            },
            "env_credentials": {
              "items": {
                "$ref": "#/$defs/ContextEnvCredential"
              },
              "title": "Env Credentials",
              "type": "array"
            },
            "files": {
              "items": {
                "$ref": "#/$defs/ContextFileRef"
              },
              "title": "Files",
              "type": "array"
            },
            "mcp": {
              "items": {
                "$ref": "#/$defs/ContextMcpServer"
              },
              "title": "Mcp",
              "type": "array"
            },
            "model": {
              "$ref": "#/$defs/ContextModel"
            },
            "pi_session": {
              "$ref": "#/$defs/ContextPiSession"
            },
            "session": {
              "$ref": "#/$defs/ContextSession"
            },
            "session_files": {
              "items": {
                "$ref": "#/$defs/ContextFileRef"
              },
              "title": "Session Files",
              "type": "array"
            },
            "skills": {
              "items": {
                "$ref": "#/$defs/ContextSkillRef"
              },
              "title": "Skills",
              "type": "array"
            }
          },
          "required": [
            "session"
          ],
          "type": "object"
        },
        "key_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Id"
        },
        "last_seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seq"
        },
        "org_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Org Id"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "run_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Mode"
        },
        "sandbox_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Image"
        },
        "tenant_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "type": "object"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "command",
      "default": "command",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "lease_id",
    "op",
    "payload",
    "session_id",
    "type"
  ],
  "title": "command sandbox.boot",
  "type": "object"
}
