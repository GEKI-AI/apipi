{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Worker to API. Command receipt; retransmits of the same id are safe.",
  "properties": {
    "id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Lease Id",
      "type": "string"
    },
    "type": {
      "const": "lease.ack",
      "default": "lease.ack",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "lease_id",
    "type"
  ],
  "title": "lease.ack message",
  "type": "object"
}
