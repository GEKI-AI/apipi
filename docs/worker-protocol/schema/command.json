{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "API to worker. `command_id` travels on the wire as `id`.",
  "properties": {
    "id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Lease Id",
      "type": "string"
    },
    "op": {
      "title": "Op",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "command",
      "default": "command",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "lease_id",
    "op",
    "payload",
    "session_id",
    "type"
  ],
  "title": "command message",
  "type": "object"
}
