{
  "$defs": {
    "SearchResultItem": {
      "properties": {
        "published_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "SearchResultItem",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "API to worker. Answer to one `search.request`.\n\n`results` has the same shape for every provider. A failure arrives\nas `ok: False` with a short `code` (`search_denied`,\n`search_unavailable`, `search_timeout`, `search_failed`,\n`invalid_request`) and a `message` that is safe to show the model.",
  "properties": {
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "ok": {
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "request_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchResultItem"
      },
      "title": "Results",
      "type": "array"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "search.reply",
      "default": "search.reply",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "session_id",
    "type"
  ],
  "title": "search.reply message",
  "type": "object"
}
