{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "API to worker. Answer to one `artifact.presign` envelope.\n\nS3 carries `url`, `headers`, and `expires_at` for a direct PUT with\nno store credentials on the worker. The shared filesystem carries\n`path`, the store-root relative path the worker must write, and no\nURL. When the latest stored bytes already match the presigned\ndigest the reply carries `unchanged` instead: no URL, no path, and\nno `upload_id`; the worker skips the upload. Quota failures arrive\nas `ok: False` with a store code (`artifact_store`,\n`artifact_too_large`, `workspace_too_large`). `file_id` was set only\nfor the kind `input_image`, which the API now refuses, so it is\nnever set.",
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "file_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Id"
    },
    "headers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Headers",
      "type": "object"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "object_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Id"
    },
    "ok": {
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "request_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "type": {
      "const": "artifact.presign.reply",
      "default": "artifact.presign.reply",
      "title": "Type",
      "type": "string"
    },
    "unchanged": {
      "default": false,
      "title": "Unchanged",
      "type": "boolean"
    },
    "upload_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upload Id"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "request_id",
    "type"
  ],
  "title": "artifact.presign.reply message",
  "type": "object"
}
